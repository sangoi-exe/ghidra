<!-- Analysis model for the qualified 28-byte helper, not a general Borland compiler ABI. -->
<prototype name="borland_f_scopy_16far" extrapop="12" stackshift="4">
  <input>
    <pentry minsize="2" maxsize="2"><register name="CX"/></pentry>
    <pentry minsize="4" maxsize="4"><addr offset="4" space="stack"/></pentry>
    <pentry minsize="4" maxsize="4"><addr offset="8" space="stack"/></pentry>
  </input>
  <!-- No manufactured AX/DX result. This does not recover a historical C return type. -->
  <output/>
  <unaffected>
    <register name="AX"/>
    <register name="BX"/>
    <register name="DX"/>
    <register name="SP"/>
    <register name="BP"/>
    <register name="SI"/>
    <register name="DI"/>
    <register name="DS"/>
    <register name="SS"/>
    <register name="CS"/>
  </unaffected>
  <!-- Clobber declarations do not express the computed ES, CX, or DF values. -->
  <killedbycall>
    <register name="CX"/>
    <register name="ES"/>
    <register name="DF"/>
    <register name="CF"/>
    <register name="PF"/>
    <register name="AF"/>
    <register name="ZF"/>
    <register name="SF"/>
    <register name="OF"/>
  </killedbycall>
</prototype>
